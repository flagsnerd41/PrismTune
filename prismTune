name: Release APK
on:
  workflow_dispatch:
  push:
    branches: [main]
permissions:
  contents: write
jobs:
  release:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          submodules: recursive
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 21
          cache: gradle
      - run: chmod +x gradlew && ./gradlew assembleGmsMobileUniversalDebug
      - id: apk
        run: echo "path=$(find . -name 'app-gms-mobile-universal-debug.apk' | head -n 1)" >> $GITHUB_OUTPUT
      - uses: softprops/action-gh-release@v2
        with:
          tag_name: build-${{ github.run_number }}
          name: PrismTune build ${{ github.run_number }}
          files: ${{ steps.apk.outputs.path }}
